#!/usr/bin/env python3
"""Generate a private structured fact-check report."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

from gyte_study_tools.fact_check import FactCheckError, generate_fact_check_report


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="gyte-fact-check",
        description="Generate a private advisory fact-check report from candidate/prepared material.",
    )
    parser.add_argument("workspace", type=Path)
    parser.add_argument(
        "--evidence",
        type=Path,
        help="Optional schema_version=1 JSON resolutions keyed by deterministic claim ID.",
    )
    args = parser.parse_args(argv)

    try:
        result = generate_fact_check_report(
            args.workspace,
            evidence_path=args.evidence,
        )
    except FactCheckError as error:
        print(f"ERROR: {error}", file=sys.stderr)
        return 1

    print(
        json.dumps(
            {
                "artifact": "fact-check-report",
                "authority": "fact-check-advisory",
                "report": str(result.report_path),
                "input": str(result.input_path),
                "claim_count": result.claim_count,
                "unresolved_count": result.unresolved_count,
                "review_granted": False,
            },
            ensure_ascii=False,
            indent=2,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
