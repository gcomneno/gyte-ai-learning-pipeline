#!/usr/bin/env python3
"""Verify or compare GYTE publication reproducibility identities."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

from gyte_study_tools.reproducibility import (
    ReproducibilityError,
    build_report,
    compare_reports,
    report_to_dict,
)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="gyte-publication-reproducibility",
        description=(
            "Verify publication byte/content reproducibility semantics for "
            "publication-manifest v2 artifacts."
        ),
    )
    parser.add_argument("manifest", type=Path)
    parser.add_argument(
        "--compare-with",
        type=Path,
        help="Compare against another publication-manifest v2.",
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        left = build_report(args.manifest)
        if args.compare_with is None:
            payload = report_to_dict(left)
        else:
            right = build_report(args.compare_with)
            payload = {
                "left": report_to_dict(left),
                "right": report_to_dict(right),
                "comparison": compare_reports(left, right),
            }
    except ReproducibilityError as error:
        print(f"ERROR: {error}", file=sys.stderr)
        return 1

    print(json.dumps(payload, ensure_ascii=False, indent=2))
    if args.compare_with is not None and not payload["comparison"]["reproducible"]:
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
